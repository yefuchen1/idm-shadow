{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IDM Shadow",
  "version": "0.2.14",
  "identifier": "com.idmshadow.desktop",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "IDM Shadow",
        "width": 1040,
        "height": 660,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCNTIxQ0ZCMkY1MUMwMkIKUldRcndGRXYreHhTZXd4V0ZPRVlVOG0zRXZUVUxFUk1zMWZUNU5WOENtYkxvVFhSRVVHbXZwVGIK",
      "endpoints": [
        "https://github.com/yefuchen1/idm-shadow/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
